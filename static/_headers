# 说明写在规则外面：Cloudflare 的 _headers 只在「整行以 # 开头」时当注释，
# 不要塞在某个路径块内部，免得被当成一个非法的响应头名字。
#
# 防 iframe 嵌套：只写 frame-ancestors，其余 CSP 指令留空 = 不限制脚本/样式，
# 所以不会影响 giscus、GoatCounter 和内联脚本。
# X-Frame-Options 是给老浏览器的同义兜底（新浏览器优先看 frame-ancestors）。
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'

/
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/posts/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/weekly/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/archive/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/categories/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/tags/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/about/
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/friends/
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=2592000

/media/*
  Cache-Control: public, max-age=2592000

/logo.svg
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/icon-192.png
  Cache-Control: public, max-age=604800

/icon-512.png
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=3600

/index.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/weekly/index.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# 搜索索引只在发布时变：允许缓存 1 小时，过期后先用旧数据、后台再刷新，
# 这样新文章最多 1 小时搜不到，又不用每次开搜索框都重新验证
/search-index.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/sitemap.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/rss.xsl
  Content-Type: text/xsl; charset=utf-8
