# Hugo 构建产物与缓存
public/
resources/
.hugo_cache/
assets/jsconfig.json
hugo_stats.json
.hugo_build.lock

# 子站点构建产物
sites/*/public/
sites/*/resources/
sites/*/.hugo_build.lock

# Mac 系统文件
.DS_Store
*~

# 编辑器配置（可选，看你是否想跟仓库分享）
.vscode/
.idea/

# 本地用 npx/esbuild 压缩 JS 时可能产生
node_modules/

# Python 脚本缓存（scripts/ 下的同步脚本）
__pycache__/
*.pyc

# 日志
*.log

# 抖音图文中间产物（hulatu-carousel 输出已改到 ~/Downloads，防止误入库）
content/**/douyin/

# 本地未发布草稿（暂不进入 Git）
content/posts/AI.md

# AI 助手的工作目录（对话记忆、技能等本地数据）。
# 仓库是公开的，这些文件不该被 publish.sh 的 `git add .` 一起推上去。
.workbuddy-ai/

# 历次改造的评审页（本地留档，不进公开仓库）
docs/reviews/
