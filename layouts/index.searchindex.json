{{- $posts := where site.RegularPages "Type" "in" (slice "posts" "weekly") -}}
{{- $items := slice -}}
{{- range $posts -}}
  {{- $item := dict
    "title" .Title
    "summary" (.Summary | plainify | truncate 120)
    "description" (.Description | plainify)
    "url" .RelPermalink
    "date" (.Date.Format "2006-01-02")
  -}}
  {{- $items = $items | append $item -}}
{{- end -}}
{{- jsonify (dict "items" $items) -}}
