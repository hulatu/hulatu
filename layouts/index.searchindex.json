[
  {{- $pages := where site.RegularPages "Type" "in" (slice "posts" "weekly") -}}
  {{- range $index, $page := $pages -}}
    {{- if $index -}},{{- end -}}
    {
      "title": {{ $page.Title | jsonify }},
      "permalink": {{ $page.Permalink | jsonify }},
      "date": {{ $page.Date.Format "2006-01-02" | jsonify }},
      "summary": {{ $page.Summary | plainify | jsonify }},
      "categories": {{ with $page.GetTerms "categories" }}{{ $titles := slice }}{{ range . }}{{ $titles = $titles | append .Title }}{{ end }}{{ delimit $titles "、" | jsonify }}{{ else }}""{{ end }},
      "content": {{ substr $page.Plain 0 600 | jsonify }}
    }
  {{- end -}}
]
