{{- $pages := .RegularPages -}}
{{- if .IsHome }}{{ $pages = where site.RegularPages "Type" "in" (slice "posts" "weekly") }}{{ end -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 }}{{ $pages = $pages | first $limit }}{{ end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>\n" | safeHTML }}
{{- printf "<?xml-stylesheet type=\"text/xsl\" href=\"%srss.xsl\"?>" site.BaseURL | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ if eq .Type "posts" }}文章{{ else }}{{ .Title }}{{ end }} - {{ site.Title }}{{ end }}</title>
    <link>{{ site.BaseURL }}</link>
    <description>{{ site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    {{ with site.Copyright }}<copyright>{{ . }}</copyright>{{ end }}
    {{- /* 用最新一篇文章的时间，而不是构建时间：
           否则每次推送（含每天的 Garmin 数据提交）都会让订阅端以为 feed 更新了。 */ -}}
    {{- if $pages }}
    <lastBuildDate>{{ (index $pages 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{- end }}
    {{ with .OutputFormats.Get "RSS" }}{{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}{{ end }}
    {{ with site.Params.assets.apple_touch_icon }}
    <image>
      <url>{{ . | absURL }}</url>
      <title>{{ site.Title }}</title>
      <link>{{ site.BaseURL }}</link>
    </image>
    {{ end }}
    {{ range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      {{- /* 2026-10-05 新增（D3）：文章页早就有「更新于」（靠 scripts/sync-lastmod.py 刷），
             RSS 却只发 pubDate —— 订阅端感知不到一篇被修订过。atom:updated 用 RFC3339
             （-07:00 这个写法输出 +08:00），是 Atom 里表达「更新于」的标准字段；
             RSS 2.0 的 channel 已经在上面声明了 xmlns:atom，直接写就行。
             Lastmod 等于 Date 的文章也照发（值相同，读者侧无副作用），
             这样订阅端不必去区分「有没有更新」两套解析。 */ -}}
      <atom:updated>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</atom:updated>
      <guid>{{ .Permalink }}</guid>
      {{ range .Params.categories }}<category>{{ . }}</category>{{ end }}
      {{ range .Params.tags }}<category>{{ . }}</category>{{ end }}
      <description>{{ .Summary | plainify | htmlUnescape }}</description>
      {{- /* 公式块与正文同源（partials/formula.html）：订阅端拿到的是已经换好的
             <p class="formula">，不再是裸露的 $$…$$。RSS 里没有站点的 CSS，
             所以那边只是一个普通段落 —— 总比看见两对美元符号强。 */ -}}
      <content:encoded>{{ partial "formula.html" .Content | htmlUnescape | transform.XMLEscape | safeHTML }}</content:encoded>
    </item>
    {{ end }}
  </channel>
</rss>
